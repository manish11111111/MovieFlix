<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#80FFFFFF"> <!-- This adds a ripple effect when clicked -->

    <item>
        <shape android:shape="rectangle">
            <!-- Smooth corners for a modern pill shape -->
            <corners android:radius="12dp" />

            <!-- The Magic Gradient: Bright Red to Deep Purple -->
            <gradient
                android:angle="0"
                android:startColor="#E50914"
                android:endColor="#6200EA"
                android:type="linear" />
        </shape>
    </item>
</ripple>